{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldir.local/schema/runtime_context_v1.schema.json",
  "title": "WorldIR Runtime Context V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "facts"],
  "properties": {
    "version": {"const": "1"},
    "facts": {
      "type": "array",
      "description": "Runtime Fact ids MUST be unique within this array. This cross-item invariant is enforced by the server contract model.",
      "items": {"$ref": "#/$defs/runtime_fact"}
    }
  },
  "$defs": {
    "anchor": {
      "type": "string",
      "enum": [
        "north", "south", "east", "west", "center",
        "northwest", "northeast", "southwest", "southeast", "whole"
      ]
    },
    "semantic_location": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "anchor": {"$ref": "#/$defs/anchor"},
        "inside": {
          "type": "string",
          "minLength": 1,
          "description": "Semantic reference to an object id in the request current_ir. V0 does not use Runtime Fact ids here."
        },
        "near": {
          "type": "string",
          "minLength": 1,
          "description": "Semantic reference to an object id in the request current_ir. V0 does not use Runtime Fact ids here."
        }
      }
    },
    "added_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "object_type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "added_object"},
        "object_type": {"type": "string", "minLength": 1},
        "location": {"$ref": "#/$defs/semantic_location"}
      }
    },
    "removed_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "object_type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "removed_object"},
        "object_type": {"type": "string", "minLength": 1},
        "location": {"$ref": "#/$defs/semantic_location"}
      }
    },
    "object_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "target", "state"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "object_state"},
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Persistent Godot/runtime interactable identifier; it does not need to be a World IR object id."
        },
        "state": {"type": "string", "minLength": 1}
      }
    },
    "marked_area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "mark", "location"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "marked_area"},
        "mark": {
          "type": "string",
          "enum": ["cleared", "burned"]
        },
        "location": {"$ref": "#/$defs/semantic_location"},
        "affected_type": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "runtime_fact": {
      "oneOf": [
        {"$ref": "#/$defs/added_object"},
        {"$ref": "#/$defs/removed_object"},
        {"$ref": "#/$defs/object_state"},
        {"$ref": "#/$defs/marked_area"}
      ]
    }
  }
}
